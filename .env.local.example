# ---------------------------------------------------------------------------
# Identifiants Jira / Xray - EXEMPLE
# Copier ce fichier en `.env.local` puis remplacer les valeurs.
# `.env.local` est ignore par Git : ne jamais commiter de vrai secret.
# ---------------------------------------------------------------------------

# URL de ton site Jira Cloud (sans slash final)
JIRA_BASE_URL=https://alaachaabouni09.atlassian.net

# E-mail du compte Atlassian
JIRA_EMAIL=ton.email@exemple.com

# Token cree sur https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=colle_le_token_jira_ici

# Cle du projet Jira (a creer dans Jira : WTQA)
JIRA_PROJECT_KEY=WTQA

# Xray Cloud : Jira -> Settings -> Apps -> Xray -> API Keys
XRAY_CLIENT_ID=colle_le_client_id_ici
XRAY_CLIENT_SECRET=colle_le_client_secret_ici

# Region Xray Cloud : US par defaut, EU si ton site est heberge en Europe
XRAY_BASE_URL=https://xray.cloud.getxray.app
